{
  "schemaVersion": 1,
  "id": "guildbridge",
  "version": "${version}",
  "name": "Guild Bridge",
  "description": "Hypixel guild chat and SkyBlock drop alerts to Discord (embeds), plus Discord replies in local chat.",
  "authors": [
    "asbron"
  ],
  "contact": {
    "sources": "https://github.com/anikhossin/guild_bridge"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.anikh.guildbridge.GuildBridgeClient"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "=${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.14.1"
  }
}
